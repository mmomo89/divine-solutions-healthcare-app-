{$DOMAIN} {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle /admin/django/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

# Redirect www -> apex domain. Only meaningful once DOMAIN is a real
# hostname (not an IP) and both DNS records point at this server.
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
