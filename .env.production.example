# Copy this to ".env" on your production server and fill in real values,
# then run: docker compose -f docker-compose.prod.yml up -d --build

# Your domain (no https://, no trailing slash). Caddy will request a free
# Let's Encrypt certificate for this automatically -- make sure its DNS
# A record already points at this server before you start the stack.
DOMAIN=divinesolutions.care

DJANGO_SECRET_KEY=REPLACE_WITH_A_REAL_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=divinesolutions.care,www.divinesolutions.care

# Custom admin paths -- security hardening. Change these to something
# private/hard-to-guess before going live; don't leave the defaults below
# on a real deployment. VITE_ADMIN_PATH controls the CMS's own React admin
# login (e.g. VITE_ADMIN_PATH=mgmt-7f2a91 -> https://yourdomain/mgmt-7f2a91/login).
# DJANGO_ADMIN_PATH controls the separate built-in Django admin.
VITE_ADMIN_PATH=admin
DJANGO_ADMIN_PATH=admin/django/

POSTGRES_DB=divine_solutions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

CORS_ALLOWED_ORIGINS=https://divinesolutions.care
CSRF_TRUSTED_ORIGINS=https://divinesolutions.care
VITE_API_URL=https://divinesolutions.care/api

# Optional: real SMTP so "new submission" emails actually send (otherwise
# they just print to the backend container's logs)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@yourprovider.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=website@divinesolutions.care
ADMIN_NOTIFICATION_EMAIL=Info@divinesolutions.care
